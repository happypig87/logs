<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>郵差的一生：三階段隨機事件版</title>
    <style>
        body {
            background-color: #121212;
            color: #e0e0e0;
            font-family: 'PingFang TC', 'Microsoft JhengHei', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        #game-card {
            background: #1e1e1e;
            border: 1px solid #333;
            border-radius: 12px;
            width: 100%;
            max-width: 750px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .header {
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            background: #2a2a2a;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
            text-align: center;
            font-size: 13px;
        }
        .stat-box { display: flex; flex-direction: column; align-items: center; }
        .stat-val { font-weight: bold; font-size: 18px; margin-top: 4px; }
        
        .rank-poor { color: #f44336; }
        .rank-below { color: #ff9800; }
        .rank-avg { color: #ffeb3b; }
        .rank-above { color: #8bc34a; }
        .rank-elite { color: #00e676; }

        .finance-bar {
            display: flex;
            justify-content: space-between;
            background: #252525;
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 15px;
            font-size: 14px;
        }
        .phase-indicator {
            background: #2196f3;
            color: #fff;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 10px;
        }

        #story-text {
            font-size: 15px;
            line-height: 1.6;
            min-height: 80px;
            margin-bottom: 20px;
            background: #252525;
            padding: 15px;
            border-left: 4px solid #2196f3;
            border-radius: 4px;
        }
        .options-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        button.option-btn {
            background: #2c2c2c;
            color: #fff;
            border: 1px solid #444;
            padding: 14px 18px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        button.option-btn:hover {
            background: #3a3a3a;
            border-color: #2196f3;
            transform: translateY(-2px);
        }
        .chance-badge {
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: bold;
            margin-left: 10px;
            white-space: nowrap;
        }
        .chance-high { background: #1b5e20; color: #81c784; }
        .chance-med { background: #e65100; color: #ffb74d; }
        .chance-low { background: #b71c1c; color: #e57373; }

        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; font-size: 14px; color: #bbb; }
        input[type="text"] {
            width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #444;
            border-radius: 6px; color: #fff; font-size: 16px; box-sizing: border-box;
        }
        input[type="range"] { width: 100%; accent-color: #2196f3; }
        .start-btn {
            width: 100%; background: #2196f3; text-align: center; font-weight: bold;
            font-size: 18px; margin-top: 10px; padding: 14px; border: none; border-radius: 6px; color: #fff; cursor: pointer;
        }
        .start-btn:hover { background: #1976d2; }
        #log {
            margin-top: 20px; font-size: 13px; color: #aaa; max-height: 140px;
            overflow-y: auto; border-top: 1px solid #333; padding-top: 10px; line-height: 1.5;
        }
        .hidden { display: none !important; }
        .log-success { color: #81c784; }
        .log-fail { color: #e57373; }
        .age-warning { color: #f44336; font-size: 12px; margin-top: 4px; display: none; }
    </style>
</head>
<body>

<div id="game-card">
    <!-- 入職設定 -->
    <div id="setup-screen">
        <h2 style="margin-top:0; text-align:center;">📋 郵務人員入職登記</h2>
        <p style="color:#aaa; text-align:center; font-size:14px; margin-bottom: 25px;">每年經歷「投遞問題、職場互動、生涯意外」三類挑戰。</p>
        
        <div class="form-group">
            <label for="player-name">郵務士姓名：</label>
            <input type="text" id="player-name" placeholder="請輸入姓名" value="陳大明">
        </div>

        <div class="form-group">
            <label for="start-age">入職年齡：<span id="age-val" style="color:#ffeb3b; font-weight:bold; font-size:18px;">22</span> 歲</label>
            <input type="range" id="start-age" min="18" max="50" value="22" oninput="onAgeChange(this.value)">
            <div id="age-cap-tip" class="age-warning">⚠️ 入職年齡超過 40 歲：體力最高上限受限為 60 分。</div>
        </div>

        <button class="start-btn" onclick="startGame()">正式報到入職</button>
    </div>

    <!-- 遊戲主畫面 -->
    <div id="game-screen" class="hidden">
        <div class="header">
            <div>
                <h2 style="margin:0; font-size: 20px;" id="display-name">郵務士</h2>
                <span id="display-career" style="font-size:12px; color:#aaa;">年資第 1 年</span>
            </div>
            <div><span id="age" style="font-size: 22px; color:#ffeb3b;">18</span> 歲 (退休倒數 <span id="years-left">--</span> 年)</div>
        </div>

        <div class="stats-grid">
            <div class="stat-box">體力<span id="stamina" class="stat-val">50</span></div>
            <div class="stat-box">情商<span id="eq" class="stat-val">50</span></div>
            <div class="stat-box">職場聲望<span id="reputation" class="stat-val">50</span></div>
            <div class="stat-box">應變能力<span id="adaptability" class="stat-val">50</span></div>
            <div class="stat-box">工作評價<span id="performance" class="stat-val">50</span></div>
        </div>

        <div class="finance-bar">
            <div>本年薪資：<span id="salary-display" style="color:#ffc107; font-weight:bold;">76 萬</span></div>
            <div>累積總資產：<span id="money" style="color:#4caf50; font-weight:bold;">$0 萬</span></div>
        </div>

        <div>
            <span id="phase-tag" class="phase-indicator">階段 1/3：投遞日常事件</span>
        </div>

        <div id="story-text">載入中...</div>

        <div id="options" class="options-container"></div>

        <div id="log">--- 履歷日誌 ---</div>
    </div>
</div>

<script>
let player = {
    name: "", age: 18, startAge: 18, retireAge: 65,
    stamina: 50, eq: 50, reputation: 50, adaptability: 50, performance: 50,
    money: 0,
    maxStaminaCap: 80,
    currentPhase: 1 // 1: 投遞問題, 2: 職場互動, 3: 生涯意外
};

const salaryTable = {
    1: 76, 2: 84, 3: 86, 4: 88, 5: 90, 6: 94, 7: 94, 8: 99, 9: 101, 10: 103,
    11: 106, 12: 107, 13: 109, 14: 110, 15: 111, 16: 113, 17: 115
};

function calculateSalary(serviceYear) {
    let salaryInWan = serviceYear <= 17 ? salaryTable[serviceYear] : ((serviceYear - 18) % 5 + 1 === 5 ? 128 : 121);
    return { amount: salaryInWan * 10000, displayWan: salaryInWan, statusTag: `年資第 ${serviceYear} 年` };
}

function getRandomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function onAgeChange(val) {
    document.getElementById('age-val').innerText = val;
    document.getElementById('age-cap-tip').style.display = parseInt(val) > 40 ? 'block' : 'none';
}

// ================= 三大類別龐大事件庫 (各20個) =================
const eventDatabase = {
    // 第一類：投遞中遇到的問題 (20個)
    delivery: [
        {
            title: "暴雨突襲與積水路段",
            desc: "午後突降狂風暴雨，前方路段積水嚴重，郵件有泡水風險...",
            options: [
                { text: "【穩健】暫避騎樓，將郵件套上防雨塑膠袋後等雨勢變小", baseChance: 85, statCheck: "adaptability", success: { effect: { stamina: -2, adaptability: 3, performance: 3 }, log: "✅ [成功] 郵件完好無損，客戶讚許你的細心。" }, fail: { effect: { performance: -2 }, log: "❌ [失敗] 等雨過久，部分信件稍微延誤。" } },
                { text: "【平衡】憑經驗繞道高勢巷弄繼續遞送", baseChance: 60, statCheck: "stamina", success: { effect: { stamina: -5, adaptability: 5, performance: 5 }, log: "✅ [成功] 順利繞過積水區，準時完成遞送。" }, fail: { effect: { stamina: -8, performance: -4 }, log: "❌ [失敗] 迷失在陌生巷弄，白白浪費體力與時間。" } },
                { text: "【冒險】油門一催，直接騎車衝過積水！", baseChance: 30, statCheck: "adaptability", success: { effect: { stamina: -3, reputation: 6, performance: 8 }, log: "🎉 [大成功] 奇蹟般衝過！被目擊民眾讚為「最強郵差」。" }, fail: { effect: { stamina: -10, performance: -8, money: -3000 }, log: "💥 [慘烈失敗] 引擎進水熄火，下半身包裹全濕受損。" } }
            ]
        },
        {
            title: "無繫繩惡犬攔路",
            desc: "一隻大型猛犬衝出巷口對你狂吠，堵住去路...",
            options: [
                { text: "【穩健】保持冷靜不對視，用郵差包擋前面緩步退後", baseChance: 80, statCheck: "eq", success: { effect: { eq: 4, adaptability: 2 }, log: "✅ [成功] 犬隻見無威脅後自行退去。" }, fail: { effect: { stamina: -3, eq: -2 }, log: "❌ [失敗] 被堵在巷口近20分鐘，進度嚴重受阻。" } },
                { text: "【平衡】掏出隨身肉乾試圖進行友好外交", baseChance: 60, statCheck: "eq", success: { effect: { eq: 6, reputation: 4, money: -100 }, log: "✅ [成功] 肉乾收服成功，以後這條巷子暢行無阻。" }, fail: { effect: { eq: -4, money: -100 }, log: "❌ [失敗] 狗吃完肉乾繼續狂吠，毫無效果。" } },
                { text: "【冒險】拿防身棍大聲呵斥，硬生生逼退惡犬！", baseChance: 25, statCheck: "stamina", success: { effect: { reputation: 8, stamina: 3 }, log: "🎉 [大成功] 霸氣威壓！惡犬夾著尾巴逃跑。" }, fail: { effect: { stamina: -12, performance: -6, money: -2000 }, log: "💥 [慘烈失敗] 激怒惡犬被咬傷褲管，必須就醫打針。" } }
            ]
        },
        {
            title: "暴躁客戶質疑包裹破損",
            desc: "住戶認為你弄壞了國際包裹，在門口大聲叫囂並錄影投訴...",
            options: [
                { text: "【穩健】展現專業情商，安撫對方並依規範填寫評估單", baseChance: 85, statCheck: "eq", success: { effect: { eq: 5, performance: 3 }, log: "✅ [成功] 冷靜應對化解危機，住戶自知理虧道歉。" }, fail: { effect: { eq: -3, performance: -2 }, log: "❌ [失敗] 住戶不買帳，堅持向總局申訴。" } },
                { text: "【平衡】邀請住戶當場共同開箱檢視內部物品", baseChance: 55, statCheck: "adaptability", success: { effect: { eq: 4, performance: 6 }, log: "✅ [成功] 開箱發現內部完好，誤會順利化解。" }, fail: { effect: { reputation: -5, performance: -5 }, log: "❌ [失敗] 內部物品確實受損，私下開箱違規遭檢舉。" } },
                { text: "【冒險】拿出郵件收單紀錄據理力爭，拒絕吞下悶氣！", baseChance: 20, statCheck: "reputation", success: { effect: { reputation: 8, eq: 5 }, log: "🎉 [大成功] 拿出鐵證壓制對方，住戶啞口無言道歉。" }, fail: { effect: { reputation: -8, performance: -8 }, log: "💥 [慘烈失敗] 爭執過程被上傳社團，遭局裡警告。" } }
            ]
        },
        {
            title: "老舊公寓頂樓無電梯掛號",
            desc: "連續數封重量極沉的包裹，全都要搬上無電梯的6樓...",
            options: [
                { text: "【穩健】分批咬牙搬運，安全第一防腰部受傷", baseChance: 85, statCheck: "stamina", success: { effect: { stamina: -4, performance: 4 }, log: "✅ [成功] 雖然勞累，但安全將包裹全數送達。" }, fail: { effect: { stamina: -6 }, log: "❌ [失敗] 耗費巨大量體力，導致後半天體力透支。" } },
                { text: "【平衡】一次性將包裹全部扛起，一口氣衝上6樓", baseChance: 50, statCheck: "stamina", success: { effect: { stamina: -5, performance: 8 }, log: "✅ [成功] 驚人展現效率！大幅節省投遞時間。" }, fail: { effect: { stamina: -12, performance: -3 }, log: "❌ [失敗] 閃到腰部，被迫停下休息近半小時。" } },
                { text: "【冒險】連絡住戶協商，請住戶下樓協助或改約地點", baseChance: 35, statCheck: "eq", success: { effect: { eq: 6, stamina: 1 }, log: "🎉 [大成功] 住戶非常體諒，主動下樓協助搬運。" }, fail: { effect: { performance: -6, reputation: -4 }, log: "💥 [慘烈失敗] 住戶怒斥服態度差，直接電話投訴。" } }
            ]
        },
        {
            title: "模糊不清的收件地址",
            desc: "手寫信件上的地址字跡極度潦草且部分塗改，無法辨識...",
            options: [
                { text: "【穩健】帶回局裡查閱舊戶政紀錄與地圖系統比對", baseChance: 80, statCheck: "adaptability", success: { effect: { adaptability: 4, performance: 3 }, log: "✅ [成功] 查出正確地址，成功化身死信克星。" }, fail: { effect: { adaptability: -2 }, log: "❌ [失敗] 查無此人，只能做退件處理。" } },
                { text: "【平衡】憑藉對該區巷弄的多年印象直接前往嘗試", baseChance: 55, statCheck: "adaptability", success: { effect: { adaptability: 7, reputation: 4 }, log: "✅ [成功] 直覺精準！順利找到收件住戶。" }, fail: { effect: { stamina: -5, performance: -3 }, log: "❌ [失敗] 跑錯好幾個巷弄，無功而返。" } },
                { text: "【冒險】撥打信件上隱約可見的手機號碼試探", baseChance: 30, statCheck: "eq", success: { effect: { eq: 6, adaptability: 6 }, log: "🎉 [大成功] 電話打通！對方正好在附近親自領取。" }, fail: { effect: { eq: -5, reputation: -3 }, log: "💥 [慘烈失敗] 打錯給脾氣暴躁的陌生人遭痛罵一頓。" } }
            ]
        },
        { title: "突發道路工程封鎖", desc: "主幹道突然因管線施工全線封鎖，影響整個區域遞送...", options: [
            { text: "【穩健】按標準備用路線繞行，預先通報局裡", baseChance: 85, statCheck: "adaptability", success: { effect: { adaptability: 4, performance: 2 }, log: "✅ [成功] 雖然稍微延遲，但掌控整體進度。" }, fail: { effect: { performance: -2 }, log: "❌ [失敗] 繞道路段嚴重塞車。" } },
            { text: "【平衡】穿梭防火巷與狹窄弄堂尋找捷徑", baseChance: 55, statCheck: "stamina", success: { effect: { stamina: -3, adaptability: 6 }, log: "✅ [成功] 完美穿梭小巷，完全沒受塞車影響。" }, fail: { effect: { stamina: -6, adaptability: -3 }, log: "❌ [失敗] 在死胡同裡卡了許久。" } },
            { text: "【冒險】禮貌向施工人員協調，請求臨時放行機車", baseChance: 25, statCheck: "eq", success: { effect: { eq: 8, performance: 6 }, log: "🎉 [大成功] 施工大哥熱心挪開圍欄讓你優先通過！" }, fail: { effect: { reputation: -5, eq: -4 }, log: "💥 [慘烈失敗] 被施工人員當場呵斥開裁。" } }
        ]},
        { title: "雙十節連假前郵件爆量", desc: "連假前夕包裹與信件量飆升至平日的三倍，堆積如山...", options: [
            { text: "【穩健】按照既定步調平穩投遞，加班完成", baseChance: 80, statCheck: "stamina", success: { effect: { stamina: -6, performance: 5 }, log: "✅ [成功] 穩紮穩打完成當日爆量作業。" }, fail: { effect: { stamina: -10 }, log: "❌ [失敗] 加班至深夜，體力嚴重透支。" } },
            { text: "【平衡】優化排序與路線，優先處理高時效掛號件", baseChance: 60, statCheck: "adaptability", success: { effect: { adaptability: 7, performance: 7 }, log: "✅ [成功] 路線優化極佳，提早半小時清空包裹。" }, fail: { effect: { adaptability: -4, performance: -4 }, log: "❌ [失敗] 排序錯誤導致重複跑路。" } },
            { text: "【冒險】火力全開飆速投遞，挑戰個人極限！", baseChance: 25, statCheck: "stamina", success: { effect: { stamina: -4, reputation: 10, performance: 10 }, log: "🎉 [大成功] 創下局裡最快清件紀錄！" }, fail: { effect: { stamina: -15, performance: -8, money: -1000 }, log: "💥 [慘烈失敗] 因太過匆忙導致兩件郵件放錯信箱。" } }
        ]},
        { title: "偏遠山區獨居老人郵件", desc: "需要騎車十幾公里前往山區為獨居老人送藥物掛號...", options: [
            { text: "【穩健】安全騎行，細心確認老人家安全並簽收", baseChance: 85, statCheck: "eq", success: { effect: { eq: 5, reputation: 4 }, log: "✅ [成功] 順利送達，長輩十分感激。" }, fail: { effect: { stamina: -5 }, log: "❌ [失敗] 山路彎曲耗費大量時間。" } },
            { text: "【平衡】順道為老人家帶一份山下的熱便當", baseChance: 60, statCheck: "eq", success: { effect: { eq: 8, reputation: 8, money: -100 }, log: "✅ [成功] 溫暖舉動被長輩家屬大力致謝與讚揚。" }, fail: { effect: { eq: -2, money: -100 }, log: "❌ [失敗] 老人當天剛好不在家。" } },
            { text: "【冒險】嘗試走未鋪設的陡峭山林捷徑省時間", baseChance: 30, statCheck: "stamina", success: { effect: { stamina: -3, adaptability: 8 }, log: "🎉 [大成功] 大幅縮短騎行時間！" }, fail: { effect: { stamina: -10, money: -2000 }, log: "💥 [慘烈失敗] 機車在泥濘山路打滑受損。" } }
        ]},
