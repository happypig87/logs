            { text: "【穩健】捐血 250cc，適度奉獻愛心", baseChance: 85, statCheck: "stamina", success: { effect: { reputation: 4, stamina: -2 }, log: "✅ [成功] 捐血救人，獲得紀念品。" }, fail: { effect: { stamina: -4 }, log: "❌ [失敗] 稍微有些頭暈休息了一會。" } },
            { text: "【平衡】體能狀況良好，一口氣捐血 500cc", baseChance: 60, statCheck: "stamina", success: { effect: { reputation: 8, stamina: -3 }, log: "✅ [成功] 熱血澎湃！獲頒捐血榮譽獎狀！" }, fail: { effect: { stamina: -8 }, log: "❌ [失敗] 下午感覺較為疲倦。" } },
            { text: "【冒險】號召整條街的住戶與店家一同下樓捐血", baseChance: 25, statCheck: "reputation", success: { effect: { reputation: 15, eq: 10 }, log: "🎉 [大成功] 捐血車被擠爆！獲捐血中心特別致謝！" }, fail: { effect: { eq: -4 }, log: "💥 [慘烈失敗] 響應冷清，氣氛略顯尷尬。" } }
        ]},
