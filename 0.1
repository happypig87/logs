            { text: "【穩健】冷靜觀望，不隨意購買", baseChance: 90, statCheck: "adaptability", success: { effect: { adaptability: 2 }, log: "✅ [成功] 理性消費，避免浪費。" }, fail: { effect: { adaptability: -1 }, log: "❌ [失敗] 事後覺得有些可惜。" } },
            { text: "【平衡】憑專業知識殺價後買下作為收藏", baseChance: 60, statCheck: "adaptability", success: { effect: { adaptability: 6, money: 3000 }, log: "✅ [成功] 的確是古董！轉手賺取數千元！" }, fail: { effect: { money: -1000 }, log: "❌ [失敗] 買回家發現是近代仿製品。" } },
            { text: "【冒險】花高價買下並送交博物館鑑定", baseChance: 20, statCheck: "adaptability", success: { effect: { reputation: 15, money: 20000 }, log: "🎉 [大成功] 國家級珍貴文物！獲得高額獎金！" }, fail: { effect: { money: -5000 }, log: "💥 [慘烈失敗] 鑑定為普通舊物，損失慘重。" } }
        ]},
        { title: "意外獲得熱門演唱會門票", desc: "幸運抽中極難購買的當紅巨星演唱會門票...", options: [
            { text: "【穩健】親自前往觀賞，享受音樂盛宴", baseChance: 85, statCheck: "eq", success: { effect: { stamina: 5, eq: 5 }, log: "✅ [成功] 徹底放鬆，心靈獲得滋養！" }, fail: { effect: { stamina: -2 }, log: "❌ [失敗] 現場過於擁擠疲憊。" } },
            { text: "【平衡】高價轉售給極度想去的歌迷朋友", baseChance: 70, statCheck: "adaptability", success: { effect: { money: 8000 }, log: "✅ [成功] 順利變現，獲得豐厚利潤！" }, fail: { effect: { money: 2000 }, log: "❌ [失敗] 售價低於預期。" } },
            { text: "【冒險】將門票送給主管作為年終感謝禮", baseChance: 25, statCheck: "eq", success: { effect: { performance: 12, reputation: 8 }, log: "🎉 [大成功] 主管女兒是狂熱粉！對你感激不盡！" }, fail: { effect: { eq: -6, performance: -4 }, log: "💥 [慘烈失敗] 被質疑行賄，引發不必要誤會。" } }
        ]},
        { title: "年度個人職涯回顧與反思", desc: "年末獨自坐在公園，回首這一年的郵務歲月...", options: [
            { text: "【穩健】寫下工作日誌，歸納明年改進目標", baseChance: 85, statCheck: "adaptability", success: { effect: { adaptability: 4, performance: 3 }, log: "✅ [成功] 踏實反思，心態更趨成熟。" }, fail: { effect: { adaptability: -1 }, log: "❌ [失敗] 稍微感到些許迷茫。" } },
            { text: "【平衡】約三五好友聚餐，分享工作甘苦談", baseChance: 65, statCheck: "eq", success: { effect: { eq: 7, stamina: 4, money: -500 }, log: "✅ [成功] 友情加溫，情緒獲得良好宣洩！" }, fail: { effect: { money: -500 }, log: "❌ [失敗] 大家各忙各的難以約齊。" } },
            { text: "【冒險】將自己多年的郵差心得撰寫成書投稿", baseChance: 20, statCheck: "reputation", success: { effect: { reputation: 18, money: 15000 }, log: "🎉 [大成功] 成功出版暢銷書！成為知名郵務作家！" }, fail: { effect: { performance: -4 }, log: "💥 [慘烈失敗] 投稿遭到多家出版社退稿。" } }
        ]}
    ]
};

function startGame() {
    const nameInput = document.getElementById('player-name').value.trim();
    if (!nameInput) return alert("請輸入姓名！");

    player.name = nameInput;
    player.startAge = parseInt(document.getElementById('start-age').value);
    player.age = player.startAge;

    player.maxStaminaCap = player.startAge > 40 ? 60 : 80;

    // 五維隨機數值 20-80
    player.eq = getRandomInt(20, 80);
    player.reputation = getRandomInt(20, 80);
    player.adaptability = getRandomInt(20, 80);
    player.performance = getRandomInt(20, 80);
    player.stamina = getRandomInt(20, player.maxStaminaCap);

    player.currentPhase = 1;

    document.getElementById('setup-screen').classList.add('hidden');
    document.getElementById('game-screen').classList.remove('hidden');
    document.getElementById('display-name').innerText = player.name + " 郵務士";

    let capNotice = player.startAge > 40 ? "（因入職超過 40 歲，體力上限限制為 60 分）" : "";
    addLog(`[報到] ${player.name} 正式報到，天賦能力隨機生成完畢${capNotice}。`);
    
    startYearProcess();
}

function startYearProcess() {
    if (player.age >= player.retireAge) return endGame();

    let serviceYear = (player.age - player.startAge) + 1;
    let salaryData = calculateSalary(serviceYear);
    
    // 每年的階段 1 開始時給付年薪
    if (player.currentPhase === 1) {
        player.money += salaryData.amount;
        addLog(`💰 [發薪] 領取第 ${serviceYear} 年年薪：+$${salaryData.displayWan} 萬元。`);
    }

    document.getElementById('display-career').innerHTML = salaryData.statusTag;
    document.getElementById('salary-display').innerText = `${salaryData.displayWan} 萬`;

    loadPhaseEvent();
}

function loadPhaseEvent() {
    let poolKey = player.currentPhase === 1 ? 'delivery' : (player.currentPhase === 2 ? 'workplace' : 'life');
    let phaseName = player.currentPhase === 1 ? '階段 1/3：🚚 投遞日常事件' : (player.currentPhase === 2 ? '階段 2/3：🏢 職場與同僚互動' : '階段 3/3：🎲 突發與生活意外');

    document.getElementById('phase-tag').innerText = phaseName;

    let pool = eventDatabase[poolKey];
    let currentEvent = pool[Math.floor(Math.random() * pool.length)];

    document.getElementById('story-text').innerHTML = `
        <strong>【${player.age} 歲】${currentEvent.title}</strong><br>
        ${currentEvent.desc}
    `;

    const optionsContainer = document.getElementById('options');
    optionsContainer.innerHTML = '';

    currentEvent.options.forEach(opt => {
        let playerStat = player[opt.statCheck] || 50;
        let finalChance = Math.min(95, Math.max(5, opt.baseChance + Math.round((playerStat - 50) * 0.4)));

        let badgeClass = finalChance >= 75 ? 'chance-high' : (finalChance >= 45 ? 'chance-med' : 'chance-low');
        let badgeText = finalChance >= 75 ? '高成功率' : (finalChance >= 45 ? '中合理性' : '高風險高回報');

        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerHTML = `
            <span>${opt.text}</span>
            <span class="chance-badge ${badgeClass}">${badgeText} (${finalChance}%)</span>
        `;
        btn.onclick = () => makeChoice(opt, finalChance);
        optionsContainer.appendChild(btn);
    });

    updateUI();
}

function clampStat(statName, val) {
    let max = (statName === 'stamina') ? player.maxStaminaCap : 80;
    return Math.max(20, Math.min(max, val));
}

function makeChoice(option, finalChance) {
    let roll = Math.floor(Math.random() * 100) + 1;
    let isSuccess = roll <= finalChance;
    let result = isSuccess ? option.success : option.fail;

    if (result.effect) {
        ['stamina', 'eq', 'reputation', 'adaptability', 'performance'].forEach(s => {
            if (result.effect[s]) {
                player[s] = clampStat(s, player[s] + result.effect[s]);
            }
        });
        if (result.effect.money) player.money += result.effect.money;
    }

    addLog(`[${player.age}歲-階段${player.currentPhase}] ${result.log}`, isSuccess);

    // 推進階段
    if (player.currentPhase < 3) {
        player.currentPhase++;
        loadPhaseEvent();
    } else {
        // 完成當年度三個階段，年齡 +1，重置階段為 1
        player.currentPhase = 1;
        player.age++;
        startYearProcess();
    }
}

function getRankClass(val) {
    if (val <= 30) return 'rank-poor';
    if (val <= 40) return 'rank-below';
    if (val <= 50) return 'rank-avg';
    if (val <= 60) return 'rank-above';
    return 'rank-elite';
}

function updateUI() {
    document.getElementById('age').innerText = player.age;
    document.getElementById('years-left').innerText = player.retireAge - player.age;
    document.getElementById('money').innerText = `$${(player.money / 10000).toFixed(1)} 萬`;

    ['stamina', 'eq', 'reputation', 'adaptability', 'performance'].forEach(stat => {
        const el = document.getElementById(stat);
        el.innerText = player[stat];
        el.className = `stat-val ${getRankClass(player[stat])}`;
    });
}

function addLog(text, isSuccess = true) {
    const logBox = document.getElementById('log');
    const newEntry = document.createElement('div');
    newEntry.className = isSuccess ? 'log-success' : 'log-fail';
    newEntry.innerText = text;
    logBox.prepend(newEntry);
}

function endGame() {
    let serviceYears = player.retireAge - player.startAge;
    let avgStat = Math.round((player.stamina + player.eq + player.reputation + player.adaptability + player.performance) / 5);

    document.getElementById('story-text').innerHTML = `
        <h3 style="color:#ffeb3b; margin-top:0;">🎉 榮退紀念章 (生涯結算)</h3>
        <strong>${player.name} 郵務士，恭喜你順利退休！</strong><br>
        服役長達 ${serviceYears} 年，終點五維平均為 <strong class="${getRankClass(avgStat)}">${avgStat} 分</strong>。<br>
        累積資產：$${(player.money / 10000).toFixed(1)} 萬元。
    `;
    document.getElementById('options').innerHTML = `<button onclick="location.reload()" class="start-btn">重新開始新職涯</button>`;
}
</script>
